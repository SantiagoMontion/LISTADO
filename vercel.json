{
  "crons": [
    {
      "path": "/api/cron/sync-inventory",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/cron/sync-inventory.ts": {
      "maxDuration": 60
    },
    "api/importados-sync/products.ts": {
      "maxDuration": 30
    },
    "api/importados-sync/create-product.ts": {
      "maxDuration": 120
    },
    "api/importados-sync/orders.ts": {
      "maxDuration": 60
    },
    "api/personalizados-pdfs/pending.ts": {
      "maxDuration": 60
    },
    "api/personalizados-pdfs/file.ts": {
      "maxDuration": 30
    },
    "api/personalizados-pdfs/tag-papel.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/logistics/:path*",
      "destination": "/api/andreani/logistics/:path*"
    },
    {
      "source": "/api/shopify/:path*",
      "destination": "/api/andreani/shopify/:path*"
    },
    {
      "source": "/api/health",
      "destination": "/api/andreani/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
