{
  "name": "notmid-lista-corte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "preview": "vite preview",
    "test": "vitest run",
    "auth:set-name": "node scripts/set-user-full-name.mjs",
    "hub:users": "node scripts/hub-users-admin.mjs list",
    "hub:set-role": "node scripts/hub-users-admin.mjs set-role",
    "hub:promote-spesia-dani": "node scripts/hub-users-admin.mjs promote-spesia-dani"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.0.0",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vercel/node": "^5.1.14",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.0"
  }
}
